# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Required on Vercel. The team password for the web UI (the app refuses to run without it there).
RADAR_PASSWORD=
# Required on Vercel. Any long random string; Vercel Cron sends it to the scheduled-run endpoints.
CRON_SECRET=
# Neon Postgres connection string (added automatically by Vercel's Neon integration).
# Leave empty locally to use the embedded PGlite database in .data/.
DATABASE_URL=

# Claude: scores items, finds people and primary sources, writes the brief. Pay as you go.
ANTHROPIC_API_KEY=
# RADAR_MODEL=claude-opus-5
# Radar stops calling Claude once this month's estimated spend reaches the cap (USD).
# RADAR_AI_MONTHLY_BUDGET_USD=30

# Optional: X API (pay-per-use, no free tier). Radar stops at the monthly cap (USD).
X_BEARER_TOKEN=
# X_MONTHLY_BUDGET_USD=10

# Optional: Serper free tier (2,500 queries) for Google News publisher links and LinkedIn discovery.
SERPER_API_KEY=
# SERPER_MONTHLY_QUERIES=300

# Optional tuning.
# RADAR_TIMEZONE=America/Los_Angeles
# RADAR_RUN_BUDGET_SECONDS=250
# RADAR_MAX_TRIAGE_PER_RUN=160
# RADAR_MAX_EXTRACT_PER_RUN=20
